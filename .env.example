# Copy to .env for local development. Never commit your populated .env file.

# Local persistent storage (required by docker-compose.yml)
POSTGRES_USER=pmcosmetics
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=pmcosmetics

# Database connection for a host-run API process
DATABASE_URL=postgresql://pmcosmetics:replace-with-a-long-random-local-password@localhost:5432/pmcosmetics

# Existing application settings (replace placeholders only in your local .env)
API_PORT=3001
API_HOST=localhost
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_MODE=sandbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=replace_with_an_app_password
SMTP_FROM=noreply@pmcosmetics.com
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_S3_BUCKET=pmcosmetics
AWS_S3_REGION=us-east-1
REDIS_URL=redis://localhost:6379
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_BUSINESS_NUMBER=replace_me
STORES_ENABLED=true
WHOLESALE_ENABLED=true
RETAIL_ENABLED=true
MULTI_CURRENCY_ENABLED=false
NODE_ENV=development
LOG_LEVEL=debug
